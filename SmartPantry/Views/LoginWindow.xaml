<Window x:Class="SmartPantry.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartPantry.Views"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid Margin="208,125,155,241">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="94*"/>
            <ColumnDefinition Width="342*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="txtUsername"
                             Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Grid.ColumnSpan="3"/>

        <Button x:Name="btnLogin"                          
                            BorderThickness="0"
                            Content="Login"
                            Foreground="White"
                            FontSize="12"
                            FontFamily="Montserrat"
                            Cursor="Hand"                           
                            Margin="60,130,139,-100"
                            Command="{Binding LoginCommand}" Grid.Column="1" Grid.ColumnSpan="2">

        </Button>

        <Button x:Name="btnRegister"                          
                    BorderThickness="0"
                    Content="Register"
                    Foreground="White"
                    FontSize="12"
                    FontFamily="Montserrat"
                    Cursor="Hand"                           
                    Margin="10,231,89,-201"
                    Command="{Binding RegisterCommand}" Grid.Column="1" Grid.ColumnSpan="2">

        </Button>
        <Label Content="Label" HorizontalAlignment="Left" Margin="0,-26,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
